{
  "id": "generic-rest-vas",
  "name": "REST VAS Connector (My Wallet & other aggregators)",
  "version": "1.0.0",
  "type": "vas",
  "author": "S-ERP",
  "description": "Connect any HTTP/JSON VAS aggregator (e.g. My Wallet) without writing code. Configure the endpoints, request templates and where to find fields in the response. Templates use {{service}}, {{provider}}, {{product_code}}, {{recipient}}, {{amount}}, {{amount_cents}}, {{reference}}, {{api_key}}, {{merchant_id}}.",
  "config": [
    { "key": "base_url", "label": "API base URL", "type": "text", "default": "https://api.example.com" },
    { "key": "auth_type", "label": "Auth type", "type": "select", "options": ["header", "bearer", "basic", "none"], "default": "bearer" },
    { "key": "api_key", "label": "API key / token", "type": "text", "secret": true },
    { "key": "api_key_header", "label": "API key header name (for 'header' auth)", "type": "text", "default": "X-API-Key" },
    { "key": "username", "label": "Username (basic auth)", "type": "text" },
    { "key": "password", "label": "Password (basic auth)", "type": "text", "secret": true },
    { "key": "merchant_id", "label": "Merchant / terminal ID", "type": "text" },
    { "key": "commission_pct", "label": "Commission % (if API does not return it)", "type": "number", "default": 0 },
    { "key": "services_json", "label": "Services offered (JSON)", "type": "json", "default": "[{\"code\":\"airtime\",\"name\":\"Airtime\",\"providers\":[{\"code\":\"VCL\",\"name\":\"Vodacom\"},{\"code\":\"ECONET\",\"name\":\"Econet\"}],\"fixedAmounts\":[5,10,20,50],\"recipientLabel\":\"Phone number\"},{\"code\":\"electricity\",\"name\":\"Prepaid electricity\",\"providers\":[{\"code\":\"LEC\",\"name\":\"LEC\"}],\"needsLookup\":true,\"recipientLabel\":\"Meter number\"}]" },
    { "key": "purchase_method", "label": "Purchase HTTP method", "type": "select", "options": ["POST", "GET", "PUT"], "default": "POST" },
    { "key": "purchase_path", "label": "Purchase path", "type": "text", "default": "/v1/vend" },
    { "key": "purchase_body", "label": "Purchase body template (JSON)", "type": "json", "default": "{\"merchantId\":\"{{merchant_id}}\",\"service\":\"{{service}}\",\"network\":\"{{provider}}\",\"accountNumber\":\"{{recipient}}\",\"amount\":{{amount}},\"clientReference\":\"{{reference}}\"}" },
    { "key": "lookup_path", "label": "Lookup / meter validation path (optional)", "type": "text", "default": "" },
    { "key": "lookup_body", "label": "Lookup body template (JSON)", "type": "json", "default": "{\"service\":\"{{service}}\",\"accountNumber\":\"{{recipient}}\"}" },
    { "key": "lookup_name_field", "label": "Lookup: customer name field", "type": "text", "default": "data.customerName" },
    { "key": "status_path", "label": "Status check path (optional, may use {{provider_ref}})", "type": "text", "default": "" },
    { "key": "balance_path", "label": "Balance path (optional, GET)", "type": "text", "default": "" },
    { "key": "balance_field", "label": "Balance field", "type": "text", "default": "data.balance" },
    { "key": "success_field", "label": "Response: success field", "type": "text", "default": "status" },
    { "key": "success_values", "label": "Response: success values (comma separated)", "type": "text", "default": "success,SUCCESS,00,true" },
    { "key": "pending_values", "label": "Response: pending values", "type": "text", "default": "pending,PENDING,processing" },
    { "key": "ref_field", "label": "Response: provider reference field", "type": "text", "default": "data.transactionId" },
    { "key": "token_field", "label": "Response: token/voucher field", "type": "text", "default": "data.token" },
    { "key": "message_field", "label": "Response: message field", "type": "text", "default": "message" },
    { "key": "commission_field", "label": "Response: commission field (optional)", "type": "text", "default": "" },
    { "key": "timeout_ms", "label": "Timeout (ms)", "type": "number", "default": 45000 }
  ]
}
